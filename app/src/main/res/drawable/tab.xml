<?xml version="1.0" encoding="utf-8"?>
<!-- Floating reader toolbar: rounded on the left, runs off the right edge -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/paper" />
    <stroke android:width="2dp" android:color="@color/ink" />
    <corners android:topLeftRadius="18dp" android:bottomLeftRadius="18dp"
        android:topRightRadius="0dp" android:bottomRightRadius="0dp" />
</shape>
