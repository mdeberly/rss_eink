<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <!-- Floating toolbar, top right. Collapsed: "<" only. -->
        <LinearLayout
            android:id="@+id/tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="-3dp"
            android:background="@drawable/tab"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:id="@+id/tab_tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btn_smaller"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/press"
                    android:contentDescription="@string/text_smaller"
                    android:gravity="center"
                    android:text="A−"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_larger"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/press"
                    android:contentDescription="@string/text_larger"
                    android:gravity="center"
                    android:text="A+"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_save"
                    style="@style/IconButton"
                    android:contentDescription="@string/save"
                    android:src="@drawable/ic_star" />

                <ImageButton
                    android:id="@+id/btn_open"
                    style="@style/IconButton"
                    android:contentDescription="@string/open_original"
                    android:src="@drawable/ic_open" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@color/ink" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_toggle"
                style="@style/IconButton"
                android:layout_width="40dp"
                android:contentDescription="@string/tools"
                android:src="@drawable/ic_back" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/page_up"
            style="@style/PageButton"
            android:contentDescription="@string/previous_page"
            android:src="@drawable/ic_page_up" />

        <TextView
            android:id="@+id/page_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/page_down"
            style="@style/PageButton"
            android:contentDescription="@string/next_page"
            android:src="@drawable/ic_page_down" />
    </LinearLayout>
</LinearLayout>
